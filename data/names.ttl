<https://example.org/birds/id/name-change/2> a bird:NameChange ;
    dcterms:source "IOC 2.0 (2009)" ;
    rdfs:comment "Snowy owl merged into Bubo; ending changed to agree with the genus"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/nyctea-scandiaca> ;
    bird:toName <https://example.org/birds/id/name/bubo-scandiacus> .

<https://example.org/birds/id/name-change/3> a bird:NameChange ;
    dcterms:source "1990s checklists" ;
    rdfs:comment "South Island takahē merged with the extinct North Island takahē in Porphyrio"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/lump> ;
    bird:fromName <https://example.org/birds/id/name/notornis-hochstetteri> ;
    bird:toName <https://example.org/birds/id/name/porphyrio-mantelli> .

<https://example.org/birds/id/name-change/4> a bird:NameChange ;
    dcterms:source "Trewick 1996" ;
    rdfs:comment "Living South Island takahē separated from the extinct North Island form"@en ;
    bird:changeRegion <https://example.org/birds/vocab/region/nz> ;
    bird:changeType <https://example.org/birds/vocab/name-change/split> ;
    bird:fromName <https://example.org/birds/id/name/porphyrio-mantelli> ;
    bird:toName <https://example.org/birds/id/name/porphyrio-hochstetteri> .

<https://example.org/birds/id/name-change/5> a bird:NameChange ;
    dcterms:source "AviList v2025" ;
    rdfs:comment "Several Charadrius plovers moved to Anarhynchus"@en ;
