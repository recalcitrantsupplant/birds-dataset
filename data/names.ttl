@prefix bird: <https://example.org/birds/def/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

<https://example.org/birds/id/name-change/1> a bird:NameChange ;
    dcterms:source "Stephens 1826" ;
    rdfs:comment "Snowy owl placed in its own genus"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/strix-scandiaca> ;
    bird:toName <https://example.org/birds/id/name/nyctea-scandiaca> .

<https://example.org/birds/id/name-change/10> a bird:NameChange ;
    dcterms:source "IOC 7.1 (2017)" ;
    rdfs:comment "Large shearwaters placed in Ardenna"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/puffinus-tenuirostris> ;
    bird:toName <https://example.org/birds/id/name/ardenna-tenuirostris> .

<https://example.org/birds/id/name-change/11> a bird:NameChange ;
    dcterms:source "IOC 4.1 (2014)" ;
    rdfs:comment "Long-tailed koel placed in its own genus"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/eudynamys-taitensis> ;
    bird:toName <https://example.org/birds/id/name/urodynamis-taitensis> .

<https://example.org/birds/id/name-change/12> a bird:NameChange ;
    dcterms:source "AOS 2016" ;
    rdfs:comment "Sandhill crane placed in Antigone"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/grus-canadensis> ;
    bird:toName <https://example.org/birds/id/name/antigone-canadensis> .

<https://example.org/birds/id/name-change/13> a bird:NameChange ;
    dcterms:source "BOU 2005" ;
    rdfs:comment "Blue tits placed in Cyanistes"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/parus-caeruleus> ;
    bird:toName <https://example.org/birds/id/name/cyanistes-caeruleus> .

<https://example.org/birds/id/name-change/14> a bird:NameChange ;
    dcterms:source "Brisson 1760" ;
    rdfs:comment "Stilts placed in Himantopus"@en ;
    bird:changeType <https://example.org/birds/vocab/name-change/genus-move> ;
    bird:fromName <https://example.org/birds/id/name/charadrius-himantopus> ;
    bird:toName <https://example.org/birds/id/name/himantopus-himantopus> .

<https://example.org/birds/id/name-change/15> a bird:NameChange ;
    dcterms:source "IOC 2.0 (2009)" ;
    rdfs:comment "Pied stilt of Australasia separated from the black-winged stilt"@en ;
    bird:changeRegion <https://example.org/birds/vocab/region/nz> ;
    bird:changeType <https://example.org/birds/vocab/name-change/split> ;
    bird:fromName <https://example.org/birds/id/name/himantopus-himantopus> ;
    bird:toName <https://example.org/birds/id/name/himantopus-leucocephalus> .

<https://example.org/birds/id/name-change/16> a bird:NameChange ;
    dcterms:source "IOC 2.0 (2009)" ;
    rdfs:comment "Pied stilt of Australasia separated from the black-winged stilt"@en ;
    bird:changeRegion <https://example.org/birds/vocab/region/au> ;
    bird:changeType <https://example.org/birds/vocab/name-change/split> ;
