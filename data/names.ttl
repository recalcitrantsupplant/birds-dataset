<https://example.org/birds/id/name-change/17> a bird:NameChange ;
    dcterms:source "IOC 2.0 (2009)" ;
    rdfs:comment "Grey fantail of Australia separated from the New Zealand fantail"@en ;
    bird:changeRegion <https://example.org/birds/vocab/region/au> ;
    bird:changeType <https://example.org/birds/vocab/name-change/split> ;
    bird:fromName <https://example.org/birds/id/name/rhipidura-fuliginosa> ;
