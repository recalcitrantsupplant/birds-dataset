<https://example.org/birds/id/site/farewell-spit> a geo:Feature,
        bird:Site ;
    rdfs:label "Farewell Spit"@en ;
    dcterms:description "A 30 km sand spit at the north-west tip of the South Island, with tidal flats on its sheltered side."@en ;
