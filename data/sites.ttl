@prefix bird: <https://example.org/birds/def/> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix geo: <http://www.opengis.net/ont/geosparql#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

<https://example.org/birds/id/site/bahia-lomas> a geo:Feature,
        bird:Site ;
    rdfs:label "Bahía Lomas"@en ;
    dcterms:description "A bay in Tierra del Fuego with mudflats that extend 7 km at low tide, a winter site of red knots."@en ;
    geo:hasGeometry <https://example.org/birds/id/site/bahia-lomas/geometry> ;
    bird:country <https://example.org/birds/vocab/region/cl> ;
    bird:latitude -52.6 ;
    bird:longitude -69.0 ;
    bird:siteType <https://example.org/birds/vocab/site-type/tidal-flat> .

<https://example.org/birds/id/site/chiloe> a geo:Feature,
        bird:Site ;
    rdfs:label "Chiloé Island"@en ;
    dcterms:description "Tidal flats on the inner coast of Chiloé, the main non-breeding site of the Hudsonian godwit."@en ;
    geo:hasGeometry <https://example.org/birds/id/site/chiloe/geometry> ;
    bird:country <https://example.org/birds/vocab/region/cl> ;
    bird:latitude -41.85 ;
    bird:longitude -73.8 ;
    bird:siteType <https://example.org/birds/vocab/site-type/tidal-flat> .

<https://example.org/birds/id/site/delaware-bay> a geo:Feature,
        bird:Site ;
    rdfs:label "Delaware Bay"@en ;
    dcterms:description "A bay between New Jersey and Delaware, where red knots feed on horseshoe crab eggs in May."@en ;
    geo:hasGeometry <https://example.org/birds/id/site/delaware-bay/geometry> ;
    bird:country <https://example.org/birds/vocab/region/us> ;
    bird:latitude 39.1 ;
    bird:longitude -75.05 ;
    bird:siteType <https://example.org/birds/vocab/site-type/tidal-flat> .

<https://example.org/birds/id/site/donana> a geo:Feature,
        bird:Site ;
    rdfs:label "Doñana"@en ;
    dcterms:description "Marshes, dunes and lagoons at the mouth of the Guadalquivir in southern Spain, a national park."@en ;
