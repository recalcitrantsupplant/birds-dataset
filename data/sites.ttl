<https://example.org/birds/id/site/firth-of-thames> a geo:Feature,
        bird:Site ;
    rdfs:label "Firth of Thames"@en ;
    dcterms:description "Wide tidal flats at the south end of the Hauraki Gulf, with a shorebird centre at Pūkorokoro Miranda. Godwits, knots and wrybills gather here in thousands."@en ;
    geo:hasGeometry <https://example.org/birds/id/site/firth-of-thames/geometry> ;
    bird:country <https://example.org/birds/vocab/region/nz> ;
    bird:latitude -37.2 ;
    bird:longitude 175.33 ;
    bird:siteType <https://example.org/birds/vocab/site-type/tidal-flat> .

<https://example.org/birds/id/site/kaikoura> a geo:Feature,
        bird:Site ;
