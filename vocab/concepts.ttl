seasonalstatus:passage-migrant a skos:Concept ;
    skos:definition "Present in spring or autumn only."@en ;
    skos:inScheme <https://example.org/birds/vocab/seasonal-status> ;
    skos:prefLabel "Passage migrant"@en ;
    skos:scopeNote "Inferred by the rule set Seasonal status from GBIF monthly record counts. The counts reflect where and when people look for birds as well as where the birds are."@en ;
    skos:topConceptOf <https://example.org/birds/vocab/seasonal-status> .

seasonalstatus:resident a skos:Concept ;
    skos:definition "Present in every season."@en ;
    skos:inScheme <https://example.org/birds/vocab/seasonal-status> ;
    skos:prefLabel "Resident"@en ;
    skos:scopeNote "Inferred by the rule set Seasonal status from GBIF monthly record counts. The counts reflect where and when people look for birds as well as where the birds are."@en ;
    skos:topConceptOf <https://example.org/birds/vocab/seasonal-status> .

seasonalstatus:summer-and-winter a skos:Concept ;
    skos:definition "Present in summer and winter, absent in spring or autumn."@en ;
    skos:inScheme <https://example.org/birds/vocab/seasonal-status> ;
    skos:prefLabel "Summer and winter"@en ;
    skos:scopeNote "Inferred by the rule set Seasonal status from GBIF monthly record counts. The counts reflect where and when people look for birds as well as where the birds are."@en ;
    skos:topConceptOf <https://example.org/birds/vocab/seasonal-status> .

seasonalstatus:summer-visitor a skos:Concept ;
    skos:definition "Present in summer and absent in winter."@en ;
    skos:inScheme <https://example.org/birds/vocab/seasonal-status> ;
    skos:prefLabel "Summer visitor"@en ;
    skos:scopeNote "Inferred by the rule set Seasonal status from GBIF monthly record counts. The counts reflect where and when people look for birds as well as where the birds are."@en ;
    skos:topConceptOf <https://example.org/birds/vocab/seasonal-status> .

seasonalstatus:winter-visitor a skos:Concept ;
    skos:definition "Present in winter and absent in summer."@en ;
    skos:inScheme <https://example.org/birds/vocab/seasonal-status> ;
    skos:prefLabel "Winter visitor"@en ;
    skos:scopeNote "Inferred by the rule set Seasonal status from GBIF monthly record counts. The counts reflect where and when people look for birds as well as where the birds are."@en ;
    skos:topConceptOf <https://example.org/birds/vocab/seasonal-status> .

