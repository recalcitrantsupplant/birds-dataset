lifestyle:aerial a skos:Concept ;
    skos:definition "Forages in flight."@en ;
    skos:inScheme <https://example.org/birds/vocab/lifestyle> ;
    skos:prefLabel "Aerial"@en ;
    skos:topConceptOf <https://example.org/birds/vocab/lifestyle> .

lifestyle:aquatic a skos:Concept ;
    skos:definition "Forages on or in water."@en ;
    skos:inScheme <https://example.org/birds/vocab/lifestyle> ;
    skos:prefLabel "Aquatic"@en ;
    skos:topConceptOf <https://example.org/birds/vocab/lifestyle> .

lifestyle:generalist a skos:Concept ;
    skos:definition "Forages in several of these ways."@en ;
    skos:inScheme <https://example.org/birds/vocab/lifestyle> ;
    skos:prefLabel "Generalist"@en ;
    skos:topConceptOf <https://example.org/birds/vocab/lifestyle> .

lifestyle:insessorial a skos:Concept ;
    skos:definition "Forages while perched in trees and shrubs."@en ;
