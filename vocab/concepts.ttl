migration:migratory a skos:Concept ;
    skos:definition "Most birds of the species leave their breeding area for part of the year."@en ;
    skos:inScheme <https://example.org/birds/vocab/migration> ;
    skos:notation "3" ;
    skos:prefLabel "Migratory"@en ;
    skos:topConceptOf <https://example.org/birds/vocab/migration> .

migration:partial-migrant a skos:Concept ;
    skos:definition "Some birds of the species migrate and others stay."@en ;
    skos:inScheme <https://example.org/birds/vocab/migration> ;
    skos:notation "2" ;
    skos:prefLabel "Partial migrant"@en ;
    skos:topConceptOf <https://example.org/birds/vocab/migration> .

migration:sedentary a skos:Concept ;
    skos:definition "Most birds stay in or near their breeding area all year."@en ;
    skos:inScheme <https://example.org/birds/vocab/migration> ;
    skos:notation "1" ;
    skos:prefLabel "Sedentary"@en ;
    skos:topConceptOf <https://example.org/birds/vocab/migration> .

