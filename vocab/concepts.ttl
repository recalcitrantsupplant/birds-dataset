trophic:aquatic-predator a skos:Concept ;
    skos:broader trophic:carnivore ;
    skos:definition "Mainly fish and aquatic animals."@en ;
    skos:example "Species in this dataset: Wrybill, Bar-tailed Godwit."@en ;
    skos:inScheme <https://example.org/birds/vocab/trophic> ;
    skos:prefLabel "Aquatic predator"@en .

trophic:frugivore a skos:Concept ;
    skos:broader trophic:herbivore ;
    skos:definition "Mainly fruit."@en ;
    skos:example "Species in this dataset: New Zealand Pigeon."@en ;
    skos:inScheme <https://example.org/birds/vocab/trophic> ;
    skos:prefLabel "Frugivore"@en .

trophic:granivore a skos:Concept ;
    skos:broader trophic:herbivore ;
    skos:definition "Mainly seeds."@en ;
    skos:example "Species in this dataset: House Sparrow, Galah."@en ;
    skos:inScheme <https://example.org/birds/vocab/trophic> ;
    skos:prefLabel "Granivore"@en .

trophic:herbivore-aquatic a skos:Concept ;
    skos:broader trophic:herbivore ;
    skos:definition "Mainly aquatic plants and algae."@en ;
    skos:example "Species in this dataset: Lesser Flamingo, Mandarin Duck."@en ;
    skos:inScheme <https://example.org/birds/vocab/trophic> ;
    skos:prefLabel "Herbivore aquatic"@en .

trophic:herbivore-terrestrial a skos:Concept ;
    skos:broader trophic:herbivore ;
    skos:definition "Mainly leaves, grass and roots on land."@en ;
    skos:inScheme <https://example.org/birds/vocab/trophic> ;
    skos:prefLabel "Herbivore terrestrial"@en .

trophic:invertivore a skos:Concept ;
    skos:broader trophic:carnivore ;
    skos:definition "Mainly insects and other invertebrates."@en ;
    skos:example "Species in this dataset: Barn Swallow, Superb Lyrebird."@en ;
    skos:inScheme <https://example.org/birds/vocab/trophic> ;
    skos:prefLabel "Invertivore"@en .

trophic:nectarivore a skos:Concept ;
