food:algae a skos:Concept,
        bird:FoodResource ;
    skos:broader food:plant-food ;
    skos:definition "Blue-green algae and diatoms."@en ;
    skos:inScheme <https://example.org/birds/vocab/food> ;
    skos:prefLabel "Algae"@en .

